# FinOrchestrate configuration. Copy to .env or export the variables you need.
# Every value is optional for local development.

# HTTP server
PORT=8787
# HOST=127.0.0.1            # 0.0.0.0 in production by default

# Bearer token for MCP clients (Alexa+ connector, MCP Inspector) and the dashboard access key.
# Required in production. When unset locally, one is generated and stored in data/secrets.json.
# FINO_API_TOKEN=change-me-to-a-long-random-string

# Secret used to sign dashboard session cookies. Generated locally when unset.
# FINO_SESSION_SECRET=

# Public HTTPS origin, for example https://budget.example.com.
# Used for Host and Origin checks, secure cookies and the MCP URL shown in the UI.
# FINO_PUBLIC_URL=

# Extra allowed hostnames, comma separated. Suffix wildcards are supported:
# FINO_ALLOWED_HOSTS=*.lambda-url.us-east-1.on.aws

# Demo mode: one click sign in and the "Reset demo data" action. On by default outside production.
# FINO_DEMO_MODE=true

# Storage: file (default, data/ledger.json), memory, or dynamodb.
# FINO_STORE=file
# FINO_DATA_DIR=data
# FINO_DYNAMODB_TABLE=finorchestrate

# Guardian schedule. In process sweeps follow the policy interval set in the dashboard.
# Turn it off when EventBridge Scheduler runs the guardian Lambda instead.
# FINO_GUARDIAN_SCHEDULE=true
# FINO_GUARDIAN_START_DELAY_MINUTES=10   # demo mode default, 0 otherwise

# AWS integrations (all optional)
# AWS_REGION=us-east-1
# Amazon Bedrock model for the voice console planner. Leave unset to use the local intent engine.
# FINO_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Amazon SNS topic for guardian alerts (email, SMS, chat).
# FINO_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:finorchestrate-alerts
# Webhook for guardian alerts, for example a Slack incoming webhook.
# FINO_WEBHOOK_URL=
